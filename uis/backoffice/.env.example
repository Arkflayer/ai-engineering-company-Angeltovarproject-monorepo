# Optional server-side FastAPI origin. Defaults to http://127.0.0.1:8000 for local/Codespaces.
# Set this when the API runs on another host. Never use NEXT_PUBLIC_ for this server-only URL.
# TRACKFLOW_API_URL=https://<backend-origin>

# Candidate pipeline API (existing integration); provide the API base URL for your environment.
NEXT_PUBLIC_API_URL=<set-your-candidate-api-base-url>
